# --- Python (the bundled measurement scripts) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Node (optional JS/TS analyzer dependencies) ---
node_modules/
npm-debug.log*

# --- shrinkcode run artifacts (regenerated by the tooling, not source) ---
# metric snapshots: loc_report.py --save / complexity_report.py --save
before_loc.json
after_loc.json
before_complexity.json
after_complexity.json
# dead-code baselines
before_deadcode.txt
after_deadcode.txt
# PR-comment body written by ci_diff_report.py
shrinkcode-comment.md
# HTML report written by generate_report.py
shrinkcode_report.html
# coverage inputs / outputs read by coverage_gap_scaffold.py
.coverage
coverage.json
coverage.xml
lcov.info
coverage-final.json
# ...except the committed fixture snapshot the selftest feeds back in
!fixtures/**/coverage.json

# --- packaged skill archives ---
*.skill

# --- local development notes (not part of the published skill) ---
dev/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
